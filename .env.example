# Set environment variables in your shell; this file is not loaded automatically.
# Generate your own token; never commit it.
CWI_API_TOKEN=
CWI_BACKEND=baseline
CWI_OPERATOR_ROLE=operator
# For the optional local LLM backend:
CWI_OLLAMA_MODEL=
CWI_OLLAMA_URL=http://localhost:11434

# Single-process durable state; contains operator conversations.
CWI_DB=data/local/cwi.db
# Optional local faster-whisper model directory (install with uv sync --extra voice).
CWI_WHISPER_MODEL=
# Experimental learned assistance or fixed baseline; never controls movement permission.
CWI_ASSISTANCE_POLICY=inspect_when_possible
